{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "radius": {
      "type": "streamable-http",
      "url": "https://vccradius.netlify.app/api/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["radius:read"]
          }
        }
      }
    }
  }
}
